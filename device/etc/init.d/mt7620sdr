#!/bin/sh /etc/rc.common
# procd service for the MT7620 capture node.

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled

	config_load mt7620sdr
	config_get_bool enabled node enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/mt7620sdr-node
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger mt7620sdr
}
