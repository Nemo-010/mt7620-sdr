# Seed config for OpenWrt on the Netgear WN3000RP v3.
# Target: ramips/mt7620, device netgear_wn3000rp-v3 (8 MiB flash, 32 MiB RAM).
# Copy to the OpenWrt tree as .config, then `make defconfig`.
#
# The rt2x00 debugfs kernel option lives under `make kernel_menuconfig`
# (RT2X00_LIB_DEBUGFS). It is listed here for reference; verify it after
# defconfig, because kernel symbols are not all settable from a seed file.

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_netgear_wn3000rp-v3=y

# Wi-Fi and the debug surface the capture work talks to.
CONFIG_PACKAGE_kmod-rt2800-soc=y
CONFIG_PACKAGE_kmod-rt2x00-lib=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_KERNEL_RT2X00_LIB_DEBUGFS=y

# Tools used during bring-up and by the capture agent.
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_dropbear=y

# No LuCI: the node is headless and the host does the UI. The board's default
# package set does not include it, so this is only a reminder not to add it.
# CONFIG_PACKAGE_luci is not set

# Keep the image small on an 8 MiB part.
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
